# Copier en .env  —  .env est ignoré par git, ne le force JAMAIS avec `git add -f`.

# Identité déclarée aux programmes qui l'exigent
BB_HANDLE="mon-pseudo"
BB_HEADER="X-Bug-Bounty: mon-pseudo"

# Débit maximum autorisé par le programme (requêtes/seconde)
BB_RATE_LIMIT=5

# Clés d'API pour la recon passive (facultatives)
SHODAN_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
VIRUSTOTAL_API_KEY=""
SECURITYTRAILS_API_KEY=""
GITHUB_TOKEN=""
CHAOS_KEY=""

# Proxy local (Burp / Caido)
HTTP_PROXY_LOCAL="http://127.0.0.1:8080"
